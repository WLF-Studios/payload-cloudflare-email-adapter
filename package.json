{
  "name": "payload-cloudflare-email-adapter",
  "version": "1.0.0",
  "description": "Cloudflare Email Service adapter for Payload CMS",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "payload",
    "payloadcms",
    "email-adapter",
    "cloudflare",
    "workers",
    "email-service"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WLF-Studios/payload-cloudflare-email-adapter.git"
  },
  "homepage": "https://github.com/WLF-Studios/payload-cloudflare-email-adapter#readme",
  "bugs": {
    "url": "https://github.com/WLF-Studios/payload-cloudflare-email-adapter/issues"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm build:types && pnpm build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --outDir dist --rootDir ./src",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint ./src ./tests",
    "lint:fix": "eslint ./src --fix",
    "prepack": "pnpm test && pnpm typecheck && pnpm lint && pnpm build",
    "test": "vitest run",
    "test:int": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "devDependencies": {
    "@payloadcms/eslint-config": "3.28.0",
    "@swc/cli": "0.6.0",
    "@types/node": "22.19.9",
    "@typescript-eslint/parser": "8.61.0",
    "eslint": "^9.23.0",
    "graphql": "^16.8.1",
    "payload": "3.84.1",
    "typescript": "5.7.3",
    "vitest": "4.0.18"
  },
  "peerDependencies": {
    "payload": "^3.84.1"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {}
}
