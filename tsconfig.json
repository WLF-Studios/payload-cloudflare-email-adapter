{
  "compilerOptions": {
    "baseUrl": ".",
    "lib": [
      "DOM",
      "ES2022"
    ],
    "rootDir": "./src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "isolatedModules": true,
    "emitDeclarationOnly": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "declaration": true
  },
  "include": [
    "./src/**/*.ts"
  ]
}
